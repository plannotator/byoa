{
  "name": "@plannotator/byoa-server",
  "version": "0.1.1",
  "description": "The app side of BYOA: pairing, sessions, the long-poll and the UI stream, as one fetch-API handler. Web standard APIs only.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plannotator/byoa.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter @plannotator/byoa-server... run build"
  },
  "dependencies": {
    "@plannotator/byoa-protocol": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      }
    }
  }
}
