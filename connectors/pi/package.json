{
  "name": "@plannotator/byoa-pi",
  "version": "0.1.0",
  "description": "The BYOA connector for Pi: connects your running Pi session to every BYOA app you pair with /byoa connect.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plannotator/byoa.git",
    "directory": "connectors/pi"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter @plannotator/byoa-pi... run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "live": "node scripts/live.ts"
  },
  "dependencies": {
    "@plannotator/byoa-connector-core": "workspace:*",
    "@plannotator/byoa-protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
